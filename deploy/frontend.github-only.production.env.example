# Prepared GitHub-only production profile. Separate deployment approval required.
# This is a names/placeholder template, not a credentials file to upload.
AUTH_PROVIDER=better_auth
PUBLIC_DEMO_ONLY=false
AUTH_LOCAL_REGISTRATION_ENABLED=false
SOCIAL_REGISTRATION_MODE=public
BETTER_AUTH_URL=https://interviewprepai.webredirect.org
FRONTEND_ORIGIN=https://interviewprepai.webredirect.org
BACKEND_INTERNAL_URL=https://interview-prep-api-icyshimakaze.onrender.com

# Reuse the existing protected production values; do not generate new ones.
AUTH_DATABASE_URL=RETAIN_RESTRICTED_AUTH_ROLE_POOLED_VERIFY_FULL_CONNECTION
BETTER_AUTH_SECRET=RETAIN_PRODUCTION_SIGNING_SECRET
AUTH_RATE_LIMIT_KEY=RETAIN_PRODUCTION_RATE_LIMIT_KEY
BACKEND_PROXY_SECRET=RETAIN_MATCHED_SERVER_GATEWAY_SECRET
GITHUB_AUTH_ENABLED=true
GITHUB_CLIENT_ID=REUSE_EXISTING_GITHUB_CLIENT_ID_PRIVATELY
GITHUB_CLIENT_SECRET=REUSE_EXISTING_GITHUB_CLIENT_SECRET_PRIVATELY
GITHUB_ALLOWED_SUBJECTS=[]

# Google routes and buttons remain disabled even if credentials are retained.
GOOGLE_AUTH_ENABLED=false
GOOGLE_ALLOWED_SUBJECTS=[]
# No STAGING_* admission, mail credentials or public password signup/recovery.
