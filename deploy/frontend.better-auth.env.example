# Prepared example only. Do not apply to hosting without separate approval.
# Existing Clerk keys may remain server-side for rollback; do not copy them here.
AUTH_PROVIDER=better_auth
# Hosted registration stays closed until verified email/recovery has been implemented.
AUTH_LOCAL_REGISTRATION_ENABLED=false
PUBLIC_DEMO_ONLY=false
BETTER_AUTH_URL=https://interviewprepai.webredirect.org
FRONTEND_ORIGIN=https://interviewprepai.webredirect.org
BACKEND_INTERNAL_URL=https://interview-prep-api-icyshimakaze.onrender.com
BETTER_AUTH_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_RATE_LIMIT_KEY=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_DATABASE_URL=postgresql://interview_prep_auth:URL_ENCODED_PASSWORD@YOUR-POOLED-NEON-HOST/neondb?sslmode=verify-full
# Apply reviewed better-auth-grants.sql role defaults before connecting this role.
BACKEND_PROXY_SECRET=RETAIN_EXISTING_MATCHED_SERVER_GATEWAY_SECRET
# OAuth stays off unless separately configured; see frontend.oauth.*.env.example.
# No NEXT_PUBLIC secret, email, reset or verification configuration.

