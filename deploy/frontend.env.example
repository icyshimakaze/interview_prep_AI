# Vercel Production environment. No database credential or AI key belongs here.
BACKEND_INTERNAL_URL=https://YOUR-BACKEND.onrender.com
FRONTEND_ORIGIN=https://YOUR-PROJECT.vercel.app
BACKEND_PROXY_SECRET=replace-with-the-same-generated-token-as-the-backend
PUBLIC_DEMO_ONLY=true
ENABLE_EXPERIMENTAL_COREPACK=1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Vercel provides VERCEL=1 and VERCEL_ENV=production. Do not set them for local dev.
