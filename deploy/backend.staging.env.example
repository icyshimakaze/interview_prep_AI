# STAGING BOOTSTRAP ONLY. Not a runnable credential file.
# Populate only a NEW isolated Render service and fresh Neon staging database.
# Blank secrets/database URL must be supplied securely before initial deployment.
APP_ENV=production
AUTH_PROVIDER=clerk
AUTH_ENABLED=false
PUBLIC_DEMO_ONLY=true
AI_PROVIDER=mock
ALLOWED_ORIGINS=["https://staging-origin-unvalidated.invalid"]
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
DATABASE_CONNECT_TIMEOUT_SECONDS=10
BACKEND_PROXY_SECRET=
DEMO_RATE_LIMIT_KEY=
DEMO_TTL_SECONDS=86400
INTERVIEW_WORKER_ENABLED=true
INTERVIEW_POLL_SECONDS=600
CLEANUP_ENABLED=true
FILE_WORKER_SLOTS=1

# After origin validation, coordinate the final Better Auth profile with Vercel.
AUTH_ISSUER=
AUTH_JWKS_URL=
AUTH_AUDIENCE=interview-prep-api
AUTH_JWKS_CACHE_SECONDS=300
# The bootstrap provider selector is dormant while AUTH_ENABLED=false.
# Never attach the production environment group or supply a production DB URL.
