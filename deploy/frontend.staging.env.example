# STAGING BOOTSTRAP ONLY. Not a runnable credential file.
# Populate only a NEW isolated Vercel project after capacity/access gates pass.
# All secret fields are intentionally blank so an unchanged copy fails closed.
AUTH_PROVIDER=off
PUBLIC_DEMO_ONLY=true
AUTH_LOCAL_REGISTRATION_ENABLED=false
FRONTEND_ORIGIN=https://staging-origin-unvalidated.invalid
BACKEND_INTERNAL_URL=https://staging-api-unconfigured.invalid
BACKEND_PROXY_SECRET=

# After independent staging HTTPS/origin validation, use the final profile
# described in docs/BETTER_AUTH_PHASE_3.md. Never use production credentials.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
AUTH_RATE_LIMIT_KEY=
AUTH_DATABASE_URL=
# Do not add Clerk keys, NEXT_PUBLIC secrets, OAuth or email-provider credentials.
