# PREPARED ONLY. Separate approval required before applying to isolated staging.
# Combine with deploy/frontend.staging.env.example; never production settings.
AUTH_PROVIDER=better_auth
PUBLIC_DEMO_ONLY=false
AUTH_LOCAL_REGISTRATION_ENABLED=false
BETTER_AUTH_URL=https://interview-prep-ai-auth-staging.vercel.app
FRONTEND_ORIGIN=https://interview-prep-ai-auth-staging.vercel.app
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=REPLACE_WITH_STAGING_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_STAGING_SECRET
GOOGLE_ALLOWED_SUBJECTS=[]
GITHUB_AUTH_ENABLED=false
GITHUB_CLIENT_ID=REPLACE_WITH_STAGING_APPLICATION_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_STAGING_SECRET_VALUE
GITHUB_ALLOWED_SUBJECTS=[]
# Callback paths are /api/auth/callback/google and /api/auth/callback/github.
# No provider credentials belong on Render; it verifies the existing API JWT only.
