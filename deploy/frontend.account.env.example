# Vercel Production account profile; the recruiter demo still needs no login/key.
BACKEND_INTERNAL_URL=https://YOUR-BACKEND.onrender.com
FRONTEND_ORIGIN=https://app.YOUR-DOMAIN.example
BACKEND_PROXY_SECRET=replace-with-the-same-generated-token-as-the-backend
PUBLIC_DEMO_ONLY=false
ENABLE_EXPERIMENTAL_COREPACK=1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_SERVER_SECRET
# AI/database credentials belong only on Render. Vercel sets VERCEL/VERCEL_ENV.
