# Local development only. Replace both placeholders before starting.
APP_ENV=development
POSTGRES_DB=interview_prep
POSTGRES_USER=interview_prep
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_PORT=5433
# Native backend: keep the password in sync; URL-encode reserved characters.
DATABASE_URL=postgresql+asyncpg://interview_prep:replace-with-a-random-local-password@127.0.0.1:5433/interview_prep
# Local PostgreSQL has no TLS; production uses deploy/backend.env.example + verify-full.
DATABASE_SSL_MODE=disable
# Random key for short-lived demo and expensive-operation quota identifiers.
DEMO_RATE_LIMIT_KEY=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
API_PORT=8000
FRONTEND_PORT=3000
# Accounts are optional locally; demo works with authentication disabled.
AUTH_ENABLED=false
PUBLIC_DEMO_ONLY=false
# Optional locally; production Vercel/Render must share a random server-only value.
BACKEND_PROXY_SECRET=
AUTH_ISSUER=
AUTH_AUDIENCE=interview-prep-api
# Clerk public key is safe for the browser; the secret key stays server-side.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
FRONTEND_ORIGIN=http://localhost:3000
# xKiro is the recommended real provider. Opt in with AI_PROVIDER=xkiro.
# Mock stays the zero-key default; recruiter demo always uses mock.
AI_PROVIDER=mock
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL_SMART=qwen/qwen3.8-max:free
XKIRO_MODEL_MULTIMODAL=qwen/qwen3.8-omni-flash:free
# Optional JSON map keyed by analyze_resume, analyze_job_description, evaluate_answer,
# generate_followup, recommend_roadmap, generate_project_questions.
XKIRO_MODEL_ROUTES={}
# Explicit operator authorization required before configuring any non-:free xKiro ID.
XKIRO_ALLOW_PAID_MODELS=false
INTERVIEW_WORKER_ENABLED=true
# Native/Compose use frequent polling and the separate Compose cleanup service.
INTERVIEW_POLL_SECONDS=1
CLEANUP_ENABLED=false
FILE_WORKER_SLOTS=2
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
# Shared database-backed request budgets; reserve all possible transport attempts.
AI_OWNER_HOURLY_CALLS=60
AI_OWNER_DAILY_CALLS=200
AI_GLOBAL_DAILY_CALLS=2000
