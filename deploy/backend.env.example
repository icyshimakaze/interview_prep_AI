# Production public-demo profile. Values are examples, never real credentials.
APP_ENV=production
PUBLIC_DEMO_ONLY=true
AI_PROVIDER=mock
# Account + xKiro can run on the same app; see backend.account.env.example.
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL_SMART=qwen/qwen3.8-max:free
XKIRO_MODEL_MULTIMODAL=qwen/qwen3.8-omni-flash:free
XKIRO_MODEL_ROUTES={}
XKIRO_ALLOW_PAID_MODELS=false
AUTH_ENABLED=false
DATABASE_URL=postgresql+asyncpg://interview_prep_runtime:URL_ENCODED_PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/neondb
DATABASE_SSL_MODE=verify-full
DATABASE_CONNECT_TIMEOUT_SECONDS=10
ALLOWED_ORIGINS=["https://YOUR-PROJECT.vercel.app"]
DEMO_RATE_LIMIT_KEY=replace-with-a-generated-random-token
BACKEND_PROXY_SECRET=replace-with-a-different-generated-random-token
DEMO_TTL_SECONDS=86400
INTERVIEW_WORKER_ENABLED=true
INTERVIEW_POLL_SECONDS=600
CLEANUP_ENABLED=true
FILE_WORKER_SLOTS=1
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
