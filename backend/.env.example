# Optional native-development overrides. Root .env supplies database/auth defaults.
# Copy/edit privately only if needed; never replace an existing backend/.env.
# Backend-local values override root dotenv values; process environment wins.
AI_PROVIDER=xkiro
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL_SMART=qwen/qwen3.8-max:free
XKIRO_MODEL_MULTIMODAL=qwen/qwen3.8-omni-flash:free
XKIRO_ALLOW_PAID_MODELS=false
XKIRO_MODEL_ROUTES={}
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
