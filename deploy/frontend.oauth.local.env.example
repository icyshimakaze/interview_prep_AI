# Prepared example, not loaded automatically. Keep secrets in ignored local storage.
# Combine with the existing local Better Auth/owned database configuration.
AUTH_PROVIDER=better_auth
PUBLIC_DEMO_ONLY=false
AUTH_LOCAL_REGISTRATION_ENABLED=false
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_SECRET
# JSON array of verified Google sub values; never email addresses.
GOOGLE_ALLOWED_SUBJECTS=[]
GITHUB_AUTH_ENABLED=false
GITHUB_CLIENT_ID=REPLACE_WITH_APPLICATION_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_OAUTH_CLIENT_SECRET
# JSON array of stable numeric GitHub account IDs as strings; never login or email.
GITHUB_ALLOWED_SUBJECTS=[]
# Provider callbacks: http://localhost:3000/api/auth/callback/google and /github.
# Only user:email; no repo, read:user or offline access. Email recovery stays off.
